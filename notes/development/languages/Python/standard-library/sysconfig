$ Python standard library: sysconfig
sysconfig

`sysconfig` provides access to Python's configuration information.

code {
import sysconfig

for k, v in sorted(
   sysconfig.get_config_vars().items(),
   key=lambda item: item[0].lower(),
):
   v = str(v)
   if len(v) > 60:
      v = v[:57] + "..."
   print(f"{k:<40}: {v}")


for k in ['VERSION', 'py_version', 'CXX']:
    print(f'{k:<40}: {sysconfig.get_config_var(k)}')

for sch in sysconfig.get_scheme_names():
    print(sch)

for pn in sysconfig.get_path_names():
    print(f'{pn:<15}: {sysconfig.get_path(pn)}')
