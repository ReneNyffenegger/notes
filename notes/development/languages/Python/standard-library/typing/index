{ None

  The return type of `__init__` should be annotated with `-> None`.

}
{ NoReturn

 `NoReturn` indicates that a a function does not return normally, such as `sys.exit`.

code {
from typing import NoReturn

def fail() -> NoReturn:
    raise RuntimeError('failed')
code }

}
{ Optional

code {
from typing import Optional

def p(a: Optional[int] = 42, b: Optional[str] = 'Hello world'):
    print(f'a = {a}')
    print(f'b = {b}')

p(b='hi')
code }

